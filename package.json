{
  "name": "world-agrobusiness-global",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "cross-env NODE_OPTIONS=--no-warnings next build",
    "start": "next start",
    "payload": "cross-env NODE_OPTIONS=--no-warnings payload",
    "generate:types": "payload generate:types",
    "migrate:create": "payload migrate:create",
    "migrate": "payload migrate",
    "migrate:down": "payload migrate:down",
    "migrate:status": "payload migrate:status",
    "migrate:fresh": "payload migrate:fresh",
    "seed": "node --env-file=.env --import tsx/esm src/seed/run.ts",
    "db:migrate": "npm run migrate",
    "db:seed": "npm run seed",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:reset": "npm run migrate:fresh && npm run db:seed"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "cross-env": "^7.0.3",
    "next": "15.4.11",
    "payload": "3.91.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.18.1"
  }
}
